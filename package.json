{
  "name": "portfolio-project",
  "version": "1.0.0",
  "description": "A personal portfolio project showcasing skills, projects, and contact information.",
  "main": "src/index.tsx",
  "scripts": {
    "generate:component": "node scripts/generate-component.js",
    "dev": "vite",
    "build": "vite build",
    "postbuild": "cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "predeploy": "vite build && npm run postbuild && cp CNAME dist/CNAME",
    "deploy": "gh-pages -d dist",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\" \"scripts/**/*.ts\" \"*.{ts,json}\"",
    "build:theme": "tsx scripts/tokens/build-theme.ts"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.20",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.1",
    "gh-pages": "^6.3.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.3.5",
    "vite-plugin-svgr": "^4.3.0"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "imports": {
    "#src/*": "./src/*",
    "#styles/*": "./src/styles/*",
    "#pages/*": "./src/pages/*",
    "#components/*": "./src/components/*",
    "#assets/*": "./src/assets/*",
    "#constants/*": "./src/constants/*",
    "#providers/*": "./src/providers/*",
    "#tokens/*": "./src/tokens/*"
  }
}
