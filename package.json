{
  "name": "portfolio-project",
  "version": "1.0.0",
  "description": "A personal portfolio project showcasing skills, projects, and contact information.",
  "main": "src/index.tsx",
  "scripts": {
    "generate-index": "node scripts/generate-index-files.js",
    "generate-scss": "node scripts/generate-scss-files.js",
    "fix-svgs": "node scripts/fix-svg-attributes.js",
    "sync-icons": "node scripts/sync-icons.js",
    "build-scripts": "npm run generate-index && npm run sync-icons",
    "generate:component": "node scripts/generate-component.js",
    "dev": "npm run build-scripts && vite",
    "build": "vite build",
    "postbuild": "cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "predeploy": "vite build && npm run postbuild && cp CNAME dist/CNAME && npm run build-scripts",
    "deploy": "gh-pages -d dist",
    "build:theme": "tsx scripts/tokens/build-theme.ts",
    "plugin:watcher": "tsx scripts/tokens/watcher.ts",
    "lint:css": "stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.1",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/react-helmet": "^6.1.11",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.5.1",
    "chokidar": "^5.0.0",
    "gh-pages": "^6.3.0",
    "prettier": "3.9.9",
    "sass": "^1.89.1",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "tsx": "^4.23.15",
    "typescript": "^4.1.2",
    "vite": "^6.3.5",
    "vite-plugin-svgr": "^4.3.0",
    "ws": "^8.22.0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "allowScripts": {
    "@parcel/watcher@2.5.1": true,
    "fsevents@2.3.3": true
  },
  "imports": {
    "#src/*": "./src/*",
    "#styles/*": "./src/styles/*",
    "#pages/*": "./src/pages/*",
    "#components/*": "./src/components/*",
    "#assets/*": "./src/assets/*",
    "#constants/*": "./src/constants/*",
    "#providers/*": "./src/providers/*",
    "#tokens/*": "./src/tokens/*"
  }
}
