{
	"name": "portfolio-project",
	"version": "1.0.0",
	"description": "A personal portfolio project showcasing skills, projects, and contact information.",
	"main": "src/index.tsx",
	"scripts": {
		"generate-index": "node scripts/generate-index-files.js",
		"fix-svgs": "node scripts/fix-svg-attributes.js",
		"sync-icons": "node scripts/sync-icons.js",
		"generate:component": "node scripts/generate-component.js",
		"plugin:watcher": "tsx scripts/tokens/watcher.ts",
		"dev": "npx vite",
		"build": "npx vite build",
		"build:scripts": "npm run generate-index && npm run sync-icons",
		"build:theme": "tsx scripts/tokens/build-theme.ts",
		"postbuild": "cp dist/index.html dist/404.html",
		"preview": "npx vite preview",
		"predeploy": "npx vite build && npm run postbuild && cp CNAME dist/CNAME && npm run build-scripts",
		"deploy": "gh-pages -d dist"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"react-router-dom": "^7.6.2"
	},
	"devDependencies": {
		"@figma/plugin-typings": "^1.134.0",
		"@types/node": "^24.0.1",
		"@types/react": "^19.1.6",
		"@types/react-dom": "^19.1.6",
		"@types/react-helmet": "^6.1.11",
		"@types/ws": "^8.18.1",
		"@vitejs/plugin-react": "^4.5.1",
		"chokidar": "^5.0.0",
		"esbuild": "^0.28.2",
		"gh-pages": "^6.3.0",
		"json-to-ts": "^2.1.0",
		"postcss-pxtorem-plus": "^3.5.1",
		"prettier": "3.9.6",
		"sass": "^1.89.1",
		"style-dictionary": "^5.5.2",
		"stylelint": "^17.14.1",
		"stylelint-config-standard": "^40.0.0",
		"stylelint-value-no-unknown-custom-properties": "^6.1.1",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2",
		"vite": "^6.3.5",
		"vite-plugin-svgr": "^4.3.0",
		"ws": "^8.21.3"
	},
	"overrides": {
		"postcss": "^8.5.23"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"allowScripts": {
		"@parcel/watcher@2.6.0": true,
		"fsevents@2.3.3": true,
		"esbuild@0.28.2": true
	},
	"imports": {
		"#src/*": "./src/*",
		"#tokens/*": "./src/tokens/*",
		"#styles/*": "./src/styles/*",
		"#pages/*": "./src/pages/*",
		"#components//*": "./src/components/*",
		"#data/*": "./src/data/*",
		"#util/*": "./src/util/*"
	}
}
