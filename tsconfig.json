{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "jsx": "react-jsx",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "#src/*": ["src/*"],
      "#tokens/*": ["src/tokens/*"],
      "#styles/*": ["src/styles/*"],
      "#pages/*": ["src/pages/*"],
      "#components/*": ["src/components/*"],
      "#assets/*": ["src/assets/*"],
      "#constants/*": ["src/constants/*"],
      "#providers/*": ["src/providers/*"]
    }
  },
  "include": ["src", "e2e", "*.config.ts"]
}
